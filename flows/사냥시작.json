{
  "schema_version": 1,
  "name": "사냥시작",
  "description": "블루스택 오토(자동사냥) 재개",
  "package": "",
  "steps": [
    {
      "type": "log",
      "params": {
        "message": "사냥 시작"
      }
    },
    {
      "type": "wait",
      "params": {
        "seconds": 1.5
      }
    },
    {
      "type": "tap_template",
      "params": {
        "template": "btn_auto_hunt.png",
        "timeout": 10,
        "required": true,
        "after_ms": 1000
      },
      "note": "자동사냥 토글 버튼"
    },
    {
      "type": "if_template",
      "params": {
        "template": "auto_hunt_active.png",
        "negate": true
      },
      "note": "아직 활성화 안 됐으면 한 번 더",
      "children": [
        {
          "type": "tap_template",
          "params": {
            "template": "btn_auto_hunt.png",
            "timeout": 5,
            "required": false,
            "after_ms": 800
          }
        }
      ]
    },
    {
      "type": "log",
      "params": {
        "message": "사냥 진행 중"
      }
    }
  ]
}