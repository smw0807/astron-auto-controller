{
  "schema_version": 1,
  "name": "사냥시작",
  "description": "마을에서 사냥 재개. 착륙 실패(워프게이트 밖) 시 재접속 후 재착륙. 이후 리스트→M6-1(1)→출격→편대텔레포트.",
  "package": "",
  "steps": [
    {
      "type": "log",
      "params": {
        "message": "사냥시작: 착륙"
      }
    },
    {
      "type": "if_template",
      "params": {
        "template": "scr_briefing.png",
        "region": "0.0,0.1,0.45,0.30",
        "threshold": 0.85,
        "negate": true
      },
      "children": [
        {
          "type": "tap",
          "params": {
            "x": 0.96,
            "y": 0.409,
            "after_ms": 2500
          },
          "note": "SHIFT 착륙"
        }
      ]
    },
    {
      "type": "wait",
      "params": {
        "seconds": 1.5
      }
    },
    {
      "type": "if_template",
      "params": {
        "template": "scr_briefing.png",
        "region": "0.0,0.1,0.45,0.30",
        "threshold": 0.85,
        "negate": true
      },
      "note": "브리핑 안 뜸 = 워프 정보 없음",
      "children": [
        {
          "type": "notify",
          "params": {
            "title": "사냥시작",
            "message": "워프 정보 없음 → 재접속",
            "level": "warn"
          }
        },
        {
          "type": "call_flow",
          "params": {
            "flow": "재접속"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": 2
          }
        },
        {
          "type": "tap",
          "params": {
            "x": 0.96,
            "y": 0.409,
            "after_ms": 2500
          },
          "note": "재착륙 SHIFT"
        },
        {
          "type": "wait",
          "params": {
            "seconds": 1.5
          }
        }
      ]
    },
    {
      "type": "wait_template",
      "params": {
        "template": "scr_briefing.png",
        "region": "0.0,0.1,0.45,0.30",
        "threshold": 0.85,
        "timeout": 12
      },
      "note": "브리핑 화면 대기"
    },
    {
      "type": "tap_template",
      "params": {
        "template": "tab_list.png",
        "threshold": 0.8,
        "timeout": 4,
        "after_ms": 1500,
        "required": false
      },
      "note": "리스트 탭"
    },
    {
      "type": "wait",
      "params": {
        "seconds": 1.0
      }
    },
    {
      "type": "tap_template",
      "params": {
        "template": "hg_paren1.png",
        "region": "0.0,0.32,0.45,0.60",
        "threshold": 0.9,
        "timeout": 10,
        "poll_ms": 900,
        "taps": 2,
        "tap_gap_ms": 160,
        "after_ms": 1800
      },
      "note": "M6-1 행성 (1) 더블탭"
    },
    {
      "type": "tap",
      "params": {
        "x": 0.499,
        "y": 0.444,
        "after_ms": 2500
      },
      "note": "출격하기"
    },
    {
      "type": "log",
      "params": {
        "message": "출격 → 로딩 대기"
      }
    },
    {
      "type": "wait",
      "params": {
        "seconds": 12
      }
    },
    {
      "type": "call_flow",
      "params": {
        "flow": "편대텔레포트"
      }
    },
    {
      "type": "log",
      "params": {
        "message": "사냥시작 완료"
      }
    }
  ]
}