{
  "schema_version": 1,
  "name": "편대중복가입닫기",
  "description": "중복 가입 안내와 뒤이어 남는 편입 거절 안내가 보일 때만 [터치하세요]를 눌러 닫는다.",
  "package": "",
  "steps": [
    {
      "type": "if_template",
      "params": {
