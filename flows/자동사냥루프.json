            {
              "type": "call_flow",
              "params": {
                "flow": "무기상점이동"
              }
            },
            {
              "type": "call_flow",
              "params": {
                "flow": "아이템수리"
              }
            }
          ]
        },
        {
          "type": "call_flow",
          "params": {
            "flow": "사냥터이동"
          }
        },
        {
          "type": "call_flow",
          "params": {
            "flow": "사냥시작"
          }
        }
      ],
      "else_children": [
        {
          "type": "if_template",
          "params": {
            "template": "dialog_disconnected.png"
          },
          "children": [
            {
              "type": "call_flow",
              "params": {
                "flow": "재접속"
              }
            },
            {
              "type": "call_flow",
              "params": {
                "flow": "사냥터이동"
              }
            },
            {
              "type": "call_flow",
              "params": {
                "flow": "사냥시작"
              }
            }
          ]
        }
      ]
    }
