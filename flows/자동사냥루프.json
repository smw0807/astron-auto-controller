              ]
            },
            {
              "type": "wait",
              "params": {
                "seconds": 0.5
              }
            },
            {
              "type": "if_template",
              "params": {
                "template": "hg_warp.png",
                "region": "0.25,0.15,0.5,0.55",
                "threshold": 0.8
              },
              "note": "사냥터 워프에 갇힘? (죽어서 스폰으로 밀림)",
              "children": [
                {
                  "type": "log",
                  "params": {
                    "message": "사냥터 워프 감지 → 재텔레포트"
                  }
                },
                {
                  "type": "notify",
                  "params": {
                    "title": "자동사냥",
                    "message": "스폰 갇힘 → 재텔레포트",
                    "level": "warn"
                  }
                },
                {
                  "type": "call_flow",
                  "params": {
                    "flow": "편대텔레포트"
                  }
                }
              ],
              "else_children": [
                {
                  "type": "log",
                  "params": {
                    "message": "사냥 중 - 이상 없음"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}