      "params": {
        "message": "자동사냥루프 체크"
      }
    },
    {
      "type": "if_frozen",
      "params": {
        "gap_s": 14,
        "threshold": 0.8,
        "samples": 3
      },
      "note": "화면 멈춤 = 튕김/프리징",
      "children": [
        {
          "type": "notify",
          "params": {
            "title": "자동사냥",
            "message": "화면 멈춤 → 재접속",
            "level": "warn"
          }
        },
        {
          "type": "call_flow",
          "params": {
            "flow": "재접속"
          }
        },
        {
          "type": "call_flow",
          "params": {
            "flow": "사냥시작"
          }
        }
      ],
      "else_children": [
        {
          "type": "if_template",
          "params": {
            "template": "map_tabs.png",
            "region": "0.0,0.19,0.14,0.09",
            "threshold": 0.82,
            "negate": true
          },
          "children": [
            {
              "type": "tap",
              "params": {
                "x": 0.177,
                "y": 0.939,
                "after_ms": 1300
              }
            }
          ]
        },
        {
          "type": "wait",
          "params": {
            "seconds": 0.6
          }
        },
        {
          "type": "if_template",
          "params": {
            "template": "map_tabs.png",
            "region": "0.0,0.19,0.14,0.09",
            "threshold": 0.82,
            "negate": true
          },
          "note": "한 번 더",
          "children": [
            {
              "type": "tap",
              "params": {
                "x": 0.177,
                "y": 0.939,
                "after_ms": 1300
              }
            }
          ]
        },
        {
          "type": "wait",
          "params": {
            "seconds": 0.5
          }
        },
        {
          "type": "if_template",
          "params": {
            "template": "map_village.png",
            "region": "0.0,0.15,0.32,0.66",
            "threshold": 0.82
          },
          "note": "마을 지도인가?",
          "children": [
            {
              "type": "log",
              "params": {
                "message": "마을 감지 → 사냥 재개"
              }
            },
            {
              "type": "notify",
              "params": {
                "title": "자동사냥",
                "message": "마을 감지 → 사냥 재개",
                "level": "info"
              }
            },
            {
              "type": "tap",
              "params": {
                "x": 0.177,
                "y": 0.939,
                "after_ms": 900
              },
              "note": "지도 닫기"
            },
            {
              "type": "call_flow",
              "params": {
                "flow": "사냥시작"
              }
            }
          ],
          "else_children": [
            {
              "type": "if_template",
              "params": {
                "template": "map_tabs.png",
                "region": "0.0,0.19,0.14,0.09",
                "threshold": 0.82
              },
              "children": [
                {
                  "type": "tap",
                  "params": {
                    "x": 0.177,
                    "y": 0.939,
                    "after_ms": 700
                  },
                  "note": "지도 닫기"
